# HealthFile DEMO: a second copy with the fictional Bellandi/Ferrante family,
# its own data folder and port, labelled DEMO on every page. Same models,
# same qvac serve. install-omen01.sh --demo installs it; reset with
#   node scripts/reset-demo.mjs
# Logs: journalctl --user -u healthfile-demo -f
[Unit]
Description=HealthFile demo: a fictional family, for showing the app
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/healthfile
Environment=DEMO=1
Environment=PORT=8098
Environment=HOST=127.0.0.1
Environment=DATA_DIR=%h/.local/share/healthfile-demo
Environment=QVAC_URL=http://127.0.0.1:11434/v1
Environment=QVAC_KEY_FILE=%h/qvac-lab/api-key.txt
Environment=READER_MODEL=qwen35-4b
Environment=WRITER_MODEL=qwen35-4b
Environment=EMBED_MODEL=embgemma
Environment=EXPLAIN_MODEL=medpsy
Environment=LANG_DEFAULT=it
# install-omen01.sh replaces this with the absolute path of node (nvm is not on systemd's PATH)
ExecStart=/usr/bin/env node src/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
